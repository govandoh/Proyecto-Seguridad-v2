# Copie este archivo a .env o ejecute ./scripts/generar_env.sh para crear uno con contraseñas aleatorias.

# Nombre de host con el que se abre la plataforma. WebAuthn no acepta direcciones IP.
RP_ID=plataforma.test
ORIGENES=https://plataforma.test
HTTPS_PUERTO=443
# Si cambia el puerto, inclúyalo en ORIGENES, por ejemplo https://plataforma.test:8443

# Contraseñas del broker MQTT, una por servicio.
MQTT_PASS_PLATAFORMA=cambiar
MQTT_PASS_SENSOR=cambiar
MQTT_PASS_SIM=cambiar

# Código de alta del administrador. Vacío: se genera uno y se muestra en los registros.
ADMIN_CODIGO_ALTA=

# Red: captura (eth2 real de la GNS3 VM) o demo (tráfico generado, sin GNS3).
MODO_RED=captura
IFACE=eth2
IP_CAPTURA=10.10.10.1

# Energía: inventario de cargas y banco de baterías (Tabla 13 del Entregable 2).
ENERGIA_UTIL_WH=864
EFICIENCIA_INVERSOR=0.90
CARGA_W=566.2
FACTOR_TIEMPO=30
PLANTA_ARRANQUE_S=7

SESION_INACTIVIDAD_MIN=15
API_DOCS=false
TZ=America/Guatemala
